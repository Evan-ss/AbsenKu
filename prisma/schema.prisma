// Schema Prisma untuk Aplikasi Absensi Siswa (Face Recognition)
// Database: MySQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================
// MODEL: USER (Admin, Guru & Siswa)
// ============================
model User {
  id             String    @id @default(uuid()) @db.Char(36)
  nama           String
  nis            String?   @unique
  email          String    @unique
  password       String
  role           Role      @default(SISWA)
  faceDescriptor Json?
  isActive       Boolean   @default(true)
  kelasId        String?   @db.Char(36)
  kelas          Kelas?    @relation(fields: [kelasId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  absensi     Absensi[]
  guruKelas   GuruKelas[]  @relation("GuruKelasGuru")
  suratIzin   SuratIzin[]  @relation("SuratSiswa")
  suratReview SuratIzin[]  @relation("ReviewerSurat")

  @@map("users")
}

enum Role {
  ADMIN
  SISWA
  GURU
}

// ============================
// MODEL: KELAS
// ============================
model Kelas {
  id        String   @id @default(uuid()) @db.Char(36)
  namaKelas String   @unique
  waliKelas String?
  createdAt DateTime @default(now())

  siswa     User[]
  guruKelas GuruKelas[] @relation("GuruKelasKelas")

  @@map("kelas")
}

// ============================
// MODEL: GURU KELAS (pivot guru ↔ kelas)
// Menghubungkan akun Guru dengan kelas yang menjadi tanggung jawabnya.
// Dipakai untuk "Menu Pilih Kelas" di dashboard guru.
// ============================
model GuruKelas {
  guruId    String   @db.Char(36)
  kelasId   String   @db.Char(36)
  guru      User     @relation("GuruKelasGuru", fields: [guruId], references: [id], onDelete: Cascade)
  kelas     Kelas    @relation("GuruKelasKelas", fields: [kelasId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([guruId, kelasId])
  @@map("guru_kelas")
}

// ============================
// MODEL: SURAT IZIN / SAKIT
// Pengajuan surat oleh siswa (foto bukti) yang direview guru.
// - status MENUNGGU  → "Menunggu Konfirmasi" di dashboard guru
// - Setujui          → absensi siswa menjadi SAKIT/IZIN
// - Tolak            → absensi siswa menjadi ALPA
// ============================
model SuratIzin {
  id         String      @id @default(uuid()) @db.Char(36)
  userId     String      @db.Char(36)
  user       User        @relation("SuratSiswa", fields: [userId], references: [id], onDelete: Cascade)
  tanggal    DateTime    @db.Date // tanggal absen yang diajukan
  jenis      JenisSurat  @default(IZIN)
  fotoSurat  String      @db.VarChar(500) // path/URL foto bukti di folder upload
  keterangan String?
  status     StatusSurat @default(MENUNGGU)
  reviewedBy String?     @db.Char(36) // guru yang mereview
  reviewer   User?       @relation("ReviewerSurat", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewedAt DateTime?
  createdAt  DateTime    @default(now())

  @@index([status])
  @@index([userId, tanggal])
  @@map("surat_izin")
}

enum JenisSurat {
  SAKIT
  IZIN
}

enum StatusSurat {
  MENUNGGU
  DISETUJUI
  DITOLAK
}

// ============================
// MODEL: ABSENSI
// ============================
model Absensi {
  id          String        @id @default(uuid()) @db.Char(36)
  userId      String        @db.Char(36)
  user        User          @relation(fields: [userId], references: [id])
  tanggal     DateTime      @db.Date
  waktuMasuk  DateTime?
  waktuPulang DateTime?
  status      StatusAbsensi @default(HADIR)
  keterangan  String?
  fotoWajah   String?       @db.VarChar(500)
  createdAt   DateTime      @default(now())

  @@unique([userId, tanggal])
  @@index([tanggal, status])
  @@map("absensi")
}

enum StatusAbsensi {
  HADIR
  TELAT
  IZIN
  SAKIT
  ALPA
}

// ============================
// MODEL: JADWAL ABSENSI
// ============================
model JadwalAbsensi {
  id               String   @id @default(uuid()) @db.Char(36)
  namaJadwal       String   @default("Jadwal Utama")
  jamMulaiMasuk    String
  jamSelesaiMasuk  String
  jamMulaiPulang   String?
  jamSelesaiPulang String?
  aktif            Boolean  @default(true)
  updatedAt        DateTime @updatedAt

  @@map("jadwal_absensi")
}
