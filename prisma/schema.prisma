// Schema Prisma untuk Aplikasi Absensi Siswa (Face Recognition)
// Database: MySQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================
// MODEL: USER (Admin, Guru & Siswa)
// ============================
model User {
  id             String    @id @default(uuid()) @db.Char(36)
  nama           String
  nis            String?   @unique
  email          String    @unique
  password       String
  role           Role      @default(SISWA)
  faceDescriptor Json?
  isActive       Boolean   @default(true)
  kelasId        String?   @db.Char(36)
  kelas          Kelas?    @relation(fields: [kelasId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  absensi      Absensi[]
  guruKelas    GuruKelas[]   @relation("GuruKelasGuru")
  guruMapel    GuruMapel[]   @relation("GuruMapelGuru")
  suratIzin    SuratIzin[]   @relation("SuratSiswa")
  suratReview  SuratIzin[]   @relation("ReviewerSurat")

  @@map("users")
}

enum Role {
  ADMIN
  SISWA
  GURU
}

// ============================
// MODEL: KELAS
// ============================
model Kelas {
  id        String   @id @default(uuid()) @db.Char(36)
  namaKelas String   @unique
  waliKelas String?
  createdAt DateTime @default(now())

  siswa         User[]
  guruKelas     GuruKelas[]    @relation("GuruKelasKelas")
  guruMapel     GuruMapel[]    @relation("GuruMapelKelas")
  jadwalAbsensi JadwalAbsensi[]

  @@map("kelas")
}

// ============================
// MODEL: GURU KELAS (pivot guru ↔ kelas)
// Menghubungkan akun Guru dengan kelas yang menjadi tanggung jawabnya (Wali Kelas).
// Dipakai untuk "Menu Pilih Kelas" di dashboard guru.
// ============================
model GuruKelas {
  guruId    String   @db.Char(36)
  kelasId   String   @db.Char(36)
  guru      User     @relation("GuruKelasGuru", fields: [guruId], references: [id], onDelete: Cascade)
  kelas     Kelas    @relation("GuruKelasKelas", fields: [kelasId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([guruId, kelasId])
  @@map("guru_kelas")
}

// ============================
// MODEL: GURU MAPEL (pivot guru ↔ kelas ↔ mata pelajaran)
// Menghubungkan akun Guru dengan kelas dan mata pelajaran yang diajar.
// Guru mapel bisa lihat status absensi siswa di kelas yang diajar.
// ============================
model GuruMapel {
  guruId    String   @db.Char(36)
  kelasId   String   @db.Char(36)
  mataPelajaran String
  guru      User     @relation("GuruMapelGuru", fields: [guruId], references: [id], onDelete: Cascade)
  kelas     Kelas    @relation("GuruMapelKelas", fields: [kelasId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([guruId, kelasId, mataPelajaran])
  @@map("guru_mapel")
}

// ============================
// MODEL: SURAT IZIN / SAKIT
// Pengajuan surat oleh siswa (foto bukti) yang direview guru.
// - status MENUNGGU  → "Menunggu Konfirmasi" di dashboard guru
// - Setujui          → absensi siswa menjadi SAKIT/IZIN
// - Tolak            → absensi siswa menjadi ALPA
// ============================
model SuratIzin {
  id         String      @id @default(uuid()) @db.Char(36)
  userId     String      @db.Char(36)
  user       User        @relation("SuratSiswa", fields: [userId], references: [id], onDelete: Cascade)
  tanggal    DateTime    @db.Date // tanggal absen yang diajukan
  jenis      JenisSurat  @default(IZIN)
  fotoSurat  String      @db.VarChar(500) // path/URL foto bukti di folder upload
  keterangan String?
  status     StatusSurat @default(MENUNGGU)
  reviewedBy String?     @db.Char(36) // guru yang mereview
  reviewer   User?       @relation("ReviewerSurat", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewedAt DateTime?
  createdAt  DateTime    @default(now())

  @@index([status])
  @@index([userId, tanggal])
  @@map("surat_izin")
}

enum JenisSurat {
  SAKIT
  IZIN
}

enum StatusSurat {
  MENUNGGU
  DISETUJUI
  DITOLAK
}

// ============================
// MODEL: ABSENSI
// ============================
model Absensi {
  id             String         @id @default(uuid()) @db.Char(36)
  userId         String         @db.Char(36)
  user           User           @relation(fields: [userId], references: [id])
  tanggal        DateTime       @db.Date
  waktuMasuk     DateTime?
  waktuPulang    DateTime?
  status         StatusAbsensi  @default(HADIR)
  keterangan     String?
  fotoWajah      String?        @db.VarChar(500)
  statusPulang   StatusPulang?  @default(BELUM)
  fotoPulang     String?        @db.VarChar(500)
  verifiedBy     String?        @db.Char(36)
  verifiedAt     DateTime?
  isAutoCheckout Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  logs           AbsensiLog[]

  @@unique([userId, tanggal])
  @@index([tanggal, status])
  @@map("absensi")
}

enum StatusAbsensi {
  HADIR
  TELAT
  IZIN
  SAKIT
  ALPA
}

enum StatusPulang {
  BELUM
  TEPAT_WAKTU
  LEBIH_AWAL
  AUTO
}

// ============================
// MODEL: JADWAL ABSENSI
// ============================
model JadwalAbsensi {
  id               String   @id @default(uuid()) @db.Char(36)
  namaJadwal       String   @default("Jadwal Utama")
  jamMulaiMasuk    String
  jamSelesaiMasuk  String
  jamMulaiPulang   String?
  jamSelesaiPulang String?
  aktif            Boolean  @default(true)
  kelasId          String?  @db.Char(36)
  kelas            Kelas?   @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  updatedAt        DateTime @updatedAt

  @@unique([kelasId, namaJadwal])
  @@map("jadwal_absensi")
}

// ============================
// MODEL: ABSENSI LOG (Audit Trail)
// ============================
model AbsensiLog {
  id        String   @id @default(uuid()) @db.Char(36)
  absensiId String   @db.Char(36)
  absensi   Absensi  @relation(fields: [absensiId], references: [id], onDelete: Cascade)
  actorId   String   @db.Char(36)
  actorRole Role
  action    String
  oldData   Json?
  newData   Json?
  createdAt DateTime @default(now())

  @@index([absensiId])
  @@index([actorId, createdAt])
  @@map("absensi_log")
}
